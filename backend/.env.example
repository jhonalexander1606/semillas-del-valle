# Copia este archivo como .env y completa los valores.

DJANGO_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=America/Bogota

# Base de datos MySQL (créala con crear_bd.sql)
DB_ENGINE=mysql
DB_NAME=semillero
DB_USER=semillero
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Reglas del negocio (opcionales: estos son los valores por defecto)
# Horas que se aparta un carrito sin movimiento antes de liberarlo
HORAS_RESERVA_CARRITO=24
# Con estas unidades disponibles o menos, el producto sale en la alerta de stock
STOCK_MINIMO=10
# Días antes del vencimiento en que el producto sale en la alerta de vencimiento
DIAS_ALERTA_VENCIMIENTO=60

# Intercambio de pedidos con el otro grupo (opcional)
# Dirección base de su API. Vacía: los informes usan solo los pedidos propios
API_EXTERNA_URL=
# Token que ellos nos den para consultar su API
API_EXTERNA_TOKEN=
# Token que les damos para consultar nuestra ruta. Vacío: la ruta queda cerrada
API_INTEGRACION_TOKEN=

# --- Solo para el despliegue (Render + Aiven) ---
# Dominios del frontend que pueden llamar a la API, separados por comas
CORS_ALLOWED_ORIGINS=
# Certificado CA de la base en la nube (texto PEM). Vacío en local.
DB_SSL_CA=
